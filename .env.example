# Server Configuration
PORT=3000
NODE_ENV=development

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate Limiter Settings (Sliding Window Log)
# Maximum number of allowed requests in the time window
RATE_LIMIT_MAX_REQUESTS=5
# Time window duration in seconds
RATE_LIMIT_WINDOW_SECONDS=60

# Proxy Configuration
# Set to 'true', '1', or specific IP/subnet if running behind a reverse proxy (e.g. Nginx, Cloudflare)
# Defaults to 'false' (direct client IP)
TRUST_PROXY=false
